# Copy to .env and adjust. Every value here has a working default.

CONTAINER_NAME=claude-console
# Host directory to mount at /workspace. Leave as-is for an empty scratch dir.
WORKSPACE_DIR=./workspace
# Where it appears inside the container. Set this to the project's original
# absolute path if its scripts or docs hardcode one.
WORKSPACE_PATH=/workspace
# Set this to your real timezone -- the watchdog compares Claude's local
# reset times against the container clock.
TZ=UTC

# Runtime user -- match your host user so workspace files are owned by you.
# `id -u` / `id -g`
PUID=1000
PGID=1000
# auto | always | never
CHOWN_WORKSPACE=auto

# Console
CLAUDE_ARGS=
CLAUDE_TMUX_SESSION=claude

# Status line / usage reporting
STATUSLINE_ENABLED=true
STATUSLINE_REFRESH_SECONDS=60
USAGE_STATE_FILE=/var/lib/claude-watchdog/usage.json
USAGE_STATE_MAX_AGE=1800

# Rate-limit watchdog
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MIN=10
CONTINUE_TEXT=continue
USAGE_PROBE_MIN_INTERVAL=3600
NUDGE_MIN_INTERVAL=900
USAGE_PROBE_WAIT=8
PANE_LINES=300

# Tool versions (build-time; rebuild after changing)
GH_VERSION=2.63.2
GLAB_VERSION=1.52.0

# Health check
HEALTHCHECK_INTERVAL=60s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_START_PERIOD=60s
HEALTHCHECK_RETRIES=3
