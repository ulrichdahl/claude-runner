# Copy to .env and adjust. Every value here has a working default.

CONTAINER_NAME=claude-console
# Host directory to mount at /workspace. Leave as-is for an empty scratch dir.
WORKSPACE_DIR=./workspace
# Set this to your real timezone -- the watchdog compares Claude's local
# reset times against the container clock.
TZ=UTC

# Console
CLAUDE_ARGS=
CLAUDE_TMUX_SESSION=claude

# Rate-limit watchdog
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL_MIN=10
CONTINUE_TEXT=continue
USAGE_PROBE_MIN_INTERVAL=3600
NUDGE_MIN_INTERVAL=900
USAGE_PROBE_WAIT=8
PANE_LINES=300

# Tool versions (build-time; rebuild after changing)
GH_VERSION=2.63.2
GLAB_VERSION=1.52.0
